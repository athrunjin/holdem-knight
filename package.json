{
  "name": "holdem-knight",
  "private": true,
  "description": "Assistant for organizers of live Texas Hold'em games: buy-in ledger, settlement, insurance, rake, timing and player reports",
  "author": "Cheng Jin",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @holdem-knight/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:local": "pnpm -r --workspace-concurrency=1 test:local",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:start": "pnpm --filter @holdem-knight/db db:start",
    "db:stop": "pnpm --filter @holdem-knight/db db:stop",
    "db:reset": "pnpm --filter @holdem-knight/db db:reset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "typescript": "7.0.2"
  }
}
