# Account mode needs a Supabase project (ADR 0003). Without these the app runs as a guest only,
# and the sign-in entry stays closed.
#
# For the local Supabase, `pnpm db:env` writes them to .env.local once `pnpm db:start` has run.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Making an account by email and password (ADR 0052). Online builds set `off` until there is a
# sending domain, as no code could reach anyone: sign-up is then through Google only, and the
# password reset is linked from nowhere. Unset or `on` here.
VITE_EMAIL_SIGN_UP=
